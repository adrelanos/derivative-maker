## No longer ignore temporary and backup files.
## It is better when git always lists them, so they never end up in in the
## source tarball.
#*~
#*.kate-swp

## No longer adding .directory. Otherwise one would have a hard time adding
## whonix_workstation/home/user/.kde/share/apps/dolphin/view_properties/global/.directory
## to its custom build
#.directory

packages/.directory

## ignore kdevelop project files
Whonix.kdev4
.kdev4/

## ignore temporary files for Debian package creation
debian/files
debian/tmp/
debian/*.debhelper*
debian/*.substvars
debian/*.init
debian/*.default

# ignore Docker built binaries and logs
derivative-binary/
docker/logs/

# ignore JetBrains IDE state
.idea

# ignore generated frozen sources files
build_sources/debian_stable_frozen_clearnet.sources
build_sources/debian_stable_frozen_direct_clearnet.sources

# ignore DhampirOS build outputs: these are GitHub Release assets, never commit them
*.iso
*.ova
*.vdi
*.vmdk
*.qcow2
*.raw
*.img
*.tar.zst
*.sha256
*.sha512
*.sig
dhampir-build/
